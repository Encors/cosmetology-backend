# Порт, на котором запускается сервер
PORT=3000

# URL фронтенда (для CORS)
FRONTEND_URL=http://localhost:4200

# Строка подключения к MongoDB
MONGODB_URI=mongodb://localhost:27017/cosmetology

# Секретный ключ для подписи JWT-токенов (замените на свой длинный случайный ключ)
JWT_SECRET=your-super-secret-key-change-me

# Время жизни JWT-токена (например: 1h, 7d)
JWT_EXPIRES_IN=7d
